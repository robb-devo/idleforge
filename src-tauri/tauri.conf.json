{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdleForge",
  "version": "0.1.0",
  "identifier": "app.idleforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IdleForge",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "IdleForge",
    "shortDescription": "Windows-Steuerung für externe CPU- und GPU-Miner",
    "longDescription": "IdleForge startet externe Miner (Phase 1: XMRig/XMR). Keine Algorithmen im Programm. Last ist auf 95% begrenzt.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["German", "English"],
        "startMenuFolder": "IdleForge",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
